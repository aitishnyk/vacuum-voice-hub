{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aitishnyk/vacuum-voice-hub/schemas/vvh.signed-pack-manifest.v1.schema.json",
  "title": "Whole-pack Ed25519 signed voice source fingerprint",
  "type": "object",
  "required": [
    "schema",
    "algorithm",
    "public_key_sha256",
    "payload",
    "signature",
    "install_authorized"
  ],
  "properties": {
    "schema": {
      "const": "vvh.signed-pack-manifest.v1"
    },
    "algorithm": {
      "const": "Ed25519"
    },
    "public_key_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "payload": {
      "type": "object"
    },
    "signature": {
      "type": "string"
    },
    "private_key_included": {
      "const": false
    },
    "install_authorized": {
      "const": false
    }
  }
}
