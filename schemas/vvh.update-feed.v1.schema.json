{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aitishnyk/vacuum-voice-hub/schemas/vvh.update-feed.v1.schema.json",
  "title": "Vacuum Voice Hub update feed",
  "type": "object",
  "required": [
    "schema",
    "channel",
    "current_version",
    "minimum_python",
    "release_manifest",
    "public_bundle"
  ],
  "properties": {
    "schema": {
      "const": "vvh.update-feed.v1"
    },
    "channel": {
      "const": "stable"
    },
    "current_version": {
      "type": "string"
    },
    "minimum_python": {
      "type": "string"
    },
    "release_manifest": {
      "type": "object"
    },
    "public_bundle": {
      "type": "object"
    }
  }
}
