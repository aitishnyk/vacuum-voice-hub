{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aitishnyk/vacuum-voice-hub/schemas/vvh.production-review.v1.schema.json",
  "title": "Local recording assignment and human review attestation, not certification",
  "type": "object",
  "required": [
    "schema",
    "workspace",
    "pack_id",
    "model_id",
    "locale",
    "workspace_manifest_sha256",
    "text_script_digest",
    "tasks",
    "install_authorized",
    "license_automatically_verified",
    "speaker_language_automatically_verified"
  ],
  "properties": {
    "schema": {
      "const": "vvh.production-review.v1"
    },
    "workspace": {
      "type": "string"
    },
    "pack_id": {
      "type": "string"
    },
    "model_id": {
      "type": "string"
    },
    "locale": {
      "type": "string"
    },
    "workspace_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "text_script_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "overlay_required_for_audit": {
      "type": "boolean"
    },
    "install_authorized": {
      "const": false
    },
    "license_automatically_verified": {
      "const": false
    },
    "speaker_language_automatically_verified": {
      "const": false
    },
    "tasks": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "required": [
          "semantic",
          "event_ids",
          "text",
          "audio",
          "review"
        ],
        "properties": {
          "semantic": {
            "type": "string"
          },
          "event_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer"
            }
          },
          "text": {
            "type": [
              "string",
              "null"
            ]
          },
          "audio": {
            "type": [
              "object",
              "null"
            ]
          },
          "review": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "draft",
                  "recorded",
                  "listened",
                  "approved"
                ]
              },
              "reviewer": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "language_attested": {
                "type": "boolean"
              },
              "rights_attested": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
