{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aitishnyk/vacuum-voice-hub/schemas/vvh.voicepack.v1.schema.json",
  "title": "Vacuum Voice Hub semantic voice pack",
  "type": "object",
  "required": [
    "schema",
    "id",
    "name",
    "author",
    "language",
    "adult",
    "license",
    "events"
  ],
  "properties": {
    "schema": {
      "const": "vvh.voicepack.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$"
    },
    "adult": {
      "type": "boolean"
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "source_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1000
    },
    "events": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^audio/[A-Za-z0-9._/-]+$"
      }
    }
  },
  "additionalProperties": false
}
