{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aitishnyk/vacuum-voice-hub/schemas/vvh.master-batch.v1.schema.json",
  "title": "Deterministic complete offline batch mastering manifest",
  "type": "object",
  "required": [
    "schema",
    "input_count",
    "clips",
    "clip_processing",
    "human_review_required",
    "creator_manifest_changed",
    "redistribution_verified",
    "install_authorized"
  ],
  "properties": {
    "schema": {
      "const": "vvh.master-batch.v1"
    },
    "input_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "clips": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": [
          "source_name",
          "source_sha256",
          "output_name",
          "output_sha256",
          "output_bytes",
          "before",
          "after"
        ],
        "properties": {
          "source_name": {
            "type": "string"
          },
          "output_name": {
            "type": "string",
            "pattern": "\\.wav$"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "output_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "output_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "before": {
            "type": "object"
          },
          "after": {
            "type": "object"
          }
        }
      }
    },
    "clip_processing": {
      "type": "object"
    },
    "model_identity_required_for_install": {
      "const": true
    },
    "human_review_required": {
      "const": true
    },
    "creator_manifest_changed": {
      "const": false
    },
    "redistribution_verified": {
      "const": false
    },
    "install_authorized": {
      "const": false
    }
  }
}
