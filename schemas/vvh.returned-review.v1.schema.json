{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aitishnyk/vacuum-voice-hub/schemas/vvh.returned-review.v1.schema.json",
  "title": "Reviewer import returns local draft status; external reviewer claims untrusted",
  "type": "object",
  "required": [
    "schema",
    "file",
    "model_id",
    "locale",
    "source_sha256",
    "local_approvals_transferred",
    "install_authorized"
  ],
  "properties": {
    "schema": {
      "const": "vvh.returned-review.v1"
    },
    "file": {
      "type": "string"
    },
    "model_id": {
      "type": "string"
    },
    "locale": {
      "type": "string"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "local_approvals_transferred": {
      "const": 0
    },
    "install_authorized": {
      "const": false
    }
  }
}
